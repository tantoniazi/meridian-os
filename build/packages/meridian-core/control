# Meridian OS - Core package definitions
# These are the base packages for the Meridian OS distribution

# meridian-base - Core system package
Package: meridian-base
Version: 0.1.0
Section: base
Priority: required
Architecture: any
Maintainer: Meridian OS Team <team@meridian-os.org>
Description: Meridian OS base system
 This package provides the base system configuration for Meridian OS,
 including system users, groups, basic directory structure, and
 essential system configuration files.
Depends: base-files, base-passwd, debianutils, systemd, systemd-sysv, 
         libc6, libgcc-s1, libstdc++6, bash, coreutils, findutils,
         grep, sed, gawk, diffutils, file, hostname, init-system-helpers,
         lsb-release, mime-support, netbase, sensible-utils, sysvinit-utils,
         udev, util-linux, adduser, passwd, login, shadow, sudo

# meridian-release - OS identification
Package: meridian-release
Version: 0.1.0
Section: base
Priority: required
Architecture: all
Maintainer: Meridian OS Team <team@meridian-os.org>
Description: Meridian OS release identification
 Provides /etc/os-release and /etc/meridian-release with version
 and identification information for Meridian OS.
Files:
 /etc/os-release
 /etc/meridian-release
 /etc/issue
 /etc/issue.net

# meridian-kernel-omap3 - OMAP3 kernel package
Package: meridian-kernel-omap3
Version: 6.6.0
Section: kernel
Priority: required
Architecture: armhf
Maintainer: Meridian OS Kernel Team <kernel@meridian-os.org>
Description: Linux kernel 6.6 LTS for OMAP3 (N900/N9/N950)
 This package provides the Linux kernel 6.6 LTS with OMAP3 support
 for Nokia N900, N9, and N950 devices.
 Includes device tree blobs for all supported OMAP3 devices.
Depends: linux-base, initramfs-tools, kmod, linux-firmware
Provides: linux-image-6.6.0-meridian-omap3
Conflicts: linux-image-omap3, linux-image-n900

# meridian-shell - Wayland compositor shell
Package: meridian-shell
Version: 0.1.0
Section: x11
Priority: required
Architecture: any
Maintainer: Meridian OS UI Team <ui@meridian-os.org>
Description: Meridian Shell - Adaptive Wayland compositor
 Meridian Shell is a libweston-based Wayland compositor providing
 adaptive UI for phone, tablet, and desktop form factors.
 Features gesture navigation, convergent UI, and Harmattan-inspired design.
Depends: weston, libweston-13, libwayland-server0, libwayland-client0,
         libinput10, libdrm2, libgbm1, libegl1, libgles2, libgl1,
         maliit-keyboard, maliit-plugins, pipewire, wireplumber,
         libxkbcommon0, libxkbregistry0, libxkbcommon-x11-0

# meridian-home - Home screen
Package: meridian-home
Version: 0.1.0
Section: x11
Priority: required
Architecture: any
Maintainer: Meridian OS UI Team <ui@meridian-os.org>
Description: Meridian Home - Adaptive home screen
 Adaptive home screen with app grid, widgets, search, and
 pivot navigation inspired by Harmattan.
Depends: meridian-shell, qt6-base, qt6-declarative, qt6-quick3d,
         kirigami-addons, qt6-quickcontrols2, qt6-svg,
         libqt6core6, libqt6gui6, libqt6qml6, libqt6quick6,
         libqt6widgets6

# meridian-settings - Settings application
Package: meridian-settings
Version: 0.1.0
Section: utils
Priority: required
Architecture: any
Maintainer: Meridian OS UI Team <ui@meridian-os.org>
Description: Meridian Settings - System settings application
 Convergent settings application with Kirigami and GTK4 backends.
 Covers all system settings: display, network, bluetooth, privacy, etc.
Depends: kirigami-addons, qt6-base, qt6-declarative, gtk4, libadwaita-1,
         modemmanager, network-manager, bluez, accounts-service,
         upower, udisks2, libpam-systemd

