         kirigami-addons, qt6-webchannel, libwebkit2gtk-4.1-0

# meridian-file-manager - File manager
Package: meridian-file-manager
Version: 0.1.0
Section: utils
Priority: optional
Architecture: any
Maintainer: Meridian OS Apps Team <apps@meridian-os.org>
Description: Meridian Files - File manager
 Dual GTK4 + Qt6 file manager with local, SFTP, SMB, MTP,
