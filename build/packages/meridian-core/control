         kirigami-addons, libappstream4, libappstreamqt2

# maemo5-compat - Maemo 5 compatibility layer
Package: maemo5-compat
Version: 1.0.0
Section: libs
Priority: optional
Architecture: armhf
Maintainer: Meridian OS Compat Team <compat@meridian-os.org>
Description: Maemo 5 (Fremantle) binary compatibility layer
 Provides GTK+ 2.20, Hildon 2.20, and OSSO APIs for running
 legacy N900 applications on Meridian.
Depends: libc6 (>= 2.38), libglib2.0-0, libgtk2.0-0, libhildon2-0,
         libosso1, libosso-abook1, libosso-gnomevfs2-0,
         maemo5-theme-meridian, hildon-thumbnailer

# harmattan-compat - Harmattan compatibility layer
Package: harmattan-compat
Version: 1.0.0
Section: libs
Priority: optional
Architecture: armhf
Maintainer: Meridian OS Compat Team <compat@meridian-os.org>
Description: MeeGo/Harmattan binary compatibility layer
 Provides Qt 4.8, QtQuick 1.1, and MeeGo Touch APIs for running
 legacy N9 applications on Meridian.
Depends: libc6 (>= 2.38), libqtcore4, libqtgui4, libqt4-declarative,
         libqt4-network, libqt4-sql, libqt4-xml, libqt4-script,
         libmeegotouch1, libmeegotouchcore1, libmeegotouchviews1,
         libmeegotouchplugins1, harmattan-theme-meridian

