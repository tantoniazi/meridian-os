# Meridian OS - U-Boot Configuration for Nokia N900 (rx51)
# Based on mainline U-Boot with OMAP3/N900 support

CONFIG_ARM=y
CONFIG_ARCH_OMAP3=y
CONFIG_TARGET_OMAP3_N900=y
CONFIG_SYS_CPU="ARM926EJ-S"
CONFIG_SYS_BOARD="n900"
CONFIG_SYS_SOC="omap3430"
CONFIG_SYS_CONFIG_NAME="n900"

# Boot device
CONFIG_SYS_BOOTDEV="mmc"

# Console
CONFIG_SYS_CONSOLE_INFO_QUIET=y
CONFIG_SYS_CONSOLE_IS_IN_ENV=y
CONFIG_SYS_CONSOLE_OVERWRITE_ROUTINE=y
CONFIG_SYS_CONSOLE_ENV_OVERWRITE=y
CONFIG_SERIAL_TAG=y
CONFIG_CONSOLE_TAG=y

# Memory
CONFIG_SYS_SDRAM_BASE=0x80000000
CONFIG_SYS_SDRAM_SIZE=0x10000000
CONFIG_SYS_MALLOC_LEN=0x1000000
CONFIG_SYS_INIT_SP_ADDR=0x80700000

# NAND/Flash
CONFIG_SYS_NAND_BASE=y
CONFIG_SYS_NAND_BASE_LIST=y
CONFIG_SYS_MAX_NAND_DEVICE=1
CONFIG_NAND_OMAP_GPMC=y
CONFIG_NAND_OMAP_ELM=y
CONFIG_MTD_NAND_OMAP2=y
CONFIG_CMD_NAND=y

# MMC
CONFIG_CMD_MMC=y
CONFIG_MMC_OMAP_HS=y
CONFIG_MMC_OMAP=y
CONFIG_SYS_MMC_ENV_DEV=0
CONFIG_SYS_MMC_ENV_PART=0

# USB
CONFIG_CMD_USB=y
CONFIG_USB_OMAP3=y
CONFIG_USB_EHCI_OMAP=y
CONFIG_USB_EHCI_OMAP3=y
CONFIG_USB_OHCI=y
CONFIG_USB_STORAGE=y
CONFIG_USB_GADGET=y
CONFIG_USB_GADGET_DUALSPEED=y
CONFIG_USB_GADGET_VBUS_DRAW=2
CONFIG_USB_GADGET_SERIAL=y
CONFIG_USB_GADGET_MANUFACTURER="Meridian OS"
CONFIG_USB_GADGET_VENDOR_NUM=0x0421
CONFIG_USB_GADGET_PRODUCT_NUM=0x01c8

# Network
CONFIG_CMD_NET=y
CONFIG_NETDEVICES=y
CONFIG_NETCONSOLE=y
CONFIG_NET_RANDOM_ETHADDR=y
CONFIG_CMD_DHCP=y
CONFIG_CMD_PING=y
CONFIG_CMD_TFTPPUT=y
CONFIG_CMD_TFTPBOOT=y

# Boot
CONFIG_BOOTDELAY=3
CONFIG_BOOTCOMMAND="run findfdt; run init_ostree; run boot_ostree"
CONFIG_BOOTARGS="console=ttyO2,115200 root=OSTREE=/ostree/deploy/meridian.ostree/0 ro quiet splash"

# Environment
CONFIG_ENV_SIZE=0x10000
CONFIG_ENV_OFFSET=0x0
CONFIG_ENV_OFFSET_REDUND=0x10000
CONFIG_ENV_SECT_SIZE=0x20000

# Boot scripts
CONFIG_CMD_BOOTZ=y
CONFIG_CMD_BOOTI=y
CONFIG_CMD_BOOTM=y
CONFIG_CMD_FDT=y
CONFIG_OF_LIBFDT=y
CONFIG_OF_CONTROL=y
CONFIG_OF_STDOUT_VIA_ALIAS=y
CONFIG_OF_BOARD=y
CONFIG_OF_BOARD_SETUP=y

# Device Tree
CONFIG_DEFAULT_DEVICE_TREE="omap3-n900"
CONFIG_OF_EMBED=y

# Bootloader size
CONFIG_SYS_MONITOR_LEN=0x80000
CONFIG_SYS_MONITOR_BASE=0x80000000

# Bootloader commands
CONFIG_CMD_BOOT=y
CONFIG_CMD_GO=y
CONFIG_CMD_RESET=y
CONFIG_CMD_SAVEENV=y
CONFIG_CMD_SETGETDCR=y
CONFIG_CMD_CRC32=y
CONFIG_CMD_CRC=y
CONFIG_CMD_MEMORY=y
CONFIG_CMD_MEMTEST=y
CONFIG_CMD_MISC=y
CONFIG_CMD_PART=y
CONFIG_CMD_FAT=y
CONFIG_CMD_EXT2=y
CONFIG_CMD_EXT4=y
CONFIG_CMD_EXT4_WRITE=y
CONFIG_CMD_FS=y
CONFIG_CMD_MOUNT=y
CONFIG_CMD_UMOUNT=y
CONFIG_CMD_LS=y
CONFIG_CMD_CRC=y
CONFIG_CMD_CRC32=y
CONFIG_CMD_MD5SUM=y
CONFIG_CMD_SHA1SUM=y
CONFIG_CMD_HASH=y
CONFIG_CMD_UNZIP=y
CONFIG_CMD_GZIP=y
CONFIG_CMD_BZIP2=y
CONFIG_CMD_LZMA=y
CONFIG_CMD_LZ4=y
CONFIG_CMD_ZSTD=y

# Security
CONFIG_RSA=y
CONFIG_RSA_N_SIZE=2048
CONFIG_RSA_E=65537
CONFIG_RSA_KEY_SIZE=2048
CONFIG_RSA_E_SIZE=4
CONFIG_RSA_PUBLIC_KEY_SIZE=2048
CONFIG_RSA_PRIVATE_KEY_SIZE=2048
CONFIG_RSA_SIGNATURE_SIZE=2048

# Verified boot
CONFIG_FIT=y
CONFIG_FIT_SIGNATURE=y
CONFIG_FIT_SIGNATURE_RSA=y
CONFIG_FIT_SIGNATURE_RSA2048=y
CONFIG_FIT_SIGNATURE_RSA3072=y
CONFIG_FIT_SIGNATURE_RSA4096=y
CONFIG_FIT_SIGNATURE_ECDSA=y
CONFIG_FIT_SIGNATURE_ECDSA256=y
