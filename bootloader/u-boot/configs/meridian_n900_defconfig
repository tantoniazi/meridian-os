CONFIG_FIT_SIGNATURE_RSA_KEY_SIZE=2048

# Bootloader integrity
CONFIG_BOOTLOADER_AUTHENTICATION=y
CONFIG_BOOTLOADER_VERIFY=y

# Bootloader version
CONFIG_BOOTLOADER_VERSION="Meridian OS U-Boot"
CONFIG_BOOTLOADER_BUILD_DATE="2026-10-25"
CONFIG_BOOTLOADER_BUILD_TIME="00:00:00"
CONFIG_BOOTLOADER_BUILD_ID="meridian-n900"

