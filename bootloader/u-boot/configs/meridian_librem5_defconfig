# Meridian OS - U-Boot Config for Librem 5 (i.MX8MQ)
# Based on mainline U-Boot v2024.01

CONFIG_ARM=y
CONFIG_ARM64=y
CONFIG_TARGET_IMX8MQ=y
CONFIG_SPL=y
CONFIG_SPL_LIBCOMMON_SUPPORT=y
CONFIG_SPL_LIBGENERIC_SUPPORT=y
CONFIG_SPL_MMC_SUPPORT=y
CONFIG_SPL_MMC_WRITE=y
CONFIG_SPL_NAND_SUPPORT=n
CONFIG_SPL_SPI_FLASH_SUPPORT=n
CONFIG_SPL_SPI_SUPPORT=n
CONFIG_SPL_USB_SUPPORT=n
CONFIG_SPL_ENV_SUPPORT=y
CONFIG_SPL_NET_SUPPORT=n

# Console
CONFIG_SYS_CONSOLE_IS_IN_ENV=y
CONFIG_CONS_INDEX=1
CONFIG_BAUDRATE=115200
CONFIG_SYS_NS16550=y
CONFIG_SYS_NS16550_SERIAL=y
CONFIG_SYS_NS16550_REG_SIZE=1
CONFIG_SYS_NS16550_CLK=24000000

# Memory
CONFIG_SYS_SDRAM_BASE=0x40000000
CONFIG_SYS_SDRAM_SIZE=0x80000000

# MMC
CONFIG_MMC=y
CONFIG_MMC_IMX=y
CONFIG_MMC_IMX_DMA=y
CONFIG_MMC_IMX_HS200_SUPPORT=y
CONFIG_MMC_IMX_HS400_SUPPORT=y
CONFIG_SYS_MMC_ENV_PART=0
CONFIG_SYS_MMC_ENV_DEV=0

# USB
CONFIG_USB=y
CONFIG_USB_GADGET=y
CONFIG_USB_GADGET_DOWNLOAD=y
CONFIG_USB_GADGET_MANUFACTURER="Purism"
CONFIG_USB_GADGET_VENDOR_NUM=0x1d6b
CONFIG_USB_GADGET_PRODUCT_NUM=0x0104

# Network
CONFIG_NET=y
CONFIG_NET_RANDOM_ETHADDR=y

# Environment
CONFIG_ENV_IS_IN_MMC=y
CONFIG_SYS_MMC_ENV_DEV=0
CONFIG_SYS_MMC_ENV_PART=0
CONFIG_ENV_SIZE=0x10000

# Boot
CONFIG_BOOTCOMMAND="run load_kernel; run load_fdt; run bootcmd_android"
CONFIG_BOOTDELAY=2

# Distro boot
CONFIG_BOOTDELAY=2
CONFIG_BOOTCOMMAND="run distro_bootcmd"
CONFIG_DISTRO_DEFAULTS="setenv bootargs console=ttymxc0,115200 earlycon root=/dev/mmcblk2p2 rootwait rw"
CONFIG_BOOT_TARGETS="mmc0 usb0 pxe dhcp"

# Android Boot
CONFIG_ANDROID_BOOT_IMAGE=y
CONFIG_ANDROID_BOOT_IMAGE_HASH=y
CONFIG_CMD_ANDROID=y
CONFIG_CMD_BOOTD=y
CONFIG_CMD_BOOTI=y
CONFIG_CMD_BOOTM=y
CONFIG_CMD_BOOTZ=y

# Device Tree
CONFIG_OF_LIBFDT=y
CONFIG_OF_BOARD_SETUP=y
CONFIG_OF_SYSTEM_SETUP=y

# Security
CONFIG_FIT=y
CONFIG_FIT_SIGNATURE=y
CONFIG_RSA=y
CONFIG_SHA256=y

# Commands
CONFIG_CMD_MMC=y
CONFIG_CMD_USB=y
CONFIG_CMD_DHCP=y
CONFIG_CMD_PING=y
CONFIG_CMD_TFTP=y
CONFIG_CMD_FAT=y
CONFIG_CMD_EXT2=y
CONFIG_CMD_FDT=y
CONFIG_CMD_FDT_CONFIG=y
CONFIG_CMD_BOOTZ=y
CONFIG_CMD_BOOTI=y

# Watchdog
CONFIG_HW_WATCHDOG=y
CONFIG_IMX_WATCHDOG=y

# Thermal
CONFIG_THERMAL=y
CONFIG_IMX_THERMAL=y

# PMIC
CONFIG_PMIC_BD71837=y
CONFIG_POWER_BD71837=y

# USB-C / Type-C
CONFIG_TYPEC=y
CONFIG_USB_PD=y
CONFIG_USB_PD_ALT_MODE_DP=y

# Display
CONFIG_VIDEO=y
CONFIG_VIDEO_IMX=y
CONFIG_DRM_IMX=y
CONFIG_DRM_IMX_DISPLAY=y
