# Meridian OS - Allwinner sunxi (PinePhone A64) Kernel Patches
#
# This directory contains patches for mainline Linux kernel 6.6 LTS
# to support PinePhone (Allwinner A64/sun50i) on Meridian OS.
#
# Patches are applied in order during kernel build via KAS.

# Device Tree enable
0001-arm64-dts-sun50i-a64-Add-PinePhone-device-tree-support.patch
0002-arm64-dts-sun50i-a64-Add-PinePhone-Pro-device-tree-support.patch
0003-arm64-dts-sun50i-a64-Add-DT-overlays-for-PinePhone.patch

# Display (LCD panel - ST7703)
0004-drm-panel-sitronix-st7703-Add-ST7703-panel-driver.patch
0005-drm-sun4i-Add-ST7703-support-to-sun4i-drm.patch

# Touchscreen (Goodix GT911)
0006-input-goodix-Add-GT911-support-for-PinePhone.patch
0007-input-goodix-Add-firmware-loading-for-PinePhone.patch

# WiFi (XR819 / RTL8723CS)
0008-wifi-xr819-Add-XR819-WiFi-driver.patch
0009-wifi-rtl8723cs-Add-RTL8723CS-support.patch
0010-firmware-xradio-Add-XR819-firmware-loading.patch

# Bluetooth
0011-bluetooth-rtl-Add-RTL8723CS-Bluetooth-support.patch
0012-bluetooth-hci-Add-uart-support-for-PinePhone-BT.patch

# Modem (Quectel EG25-G)
