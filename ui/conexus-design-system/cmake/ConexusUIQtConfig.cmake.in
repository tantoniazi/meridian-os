@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Qt6 6.5 REQUIRED COMPONENTS Quick QuickControls2 QuickTemplates2 QuickLayouts Svg)

include("${CMAKE_CURRENT_LIST_DIR}/ConexusUIQtTargets.cmake")

# Provide a convenient variable for the QML import path
set(CONEXUS_UI_QT_QML_IMPORT_PATH "@PACKAGE_PREFIX_DIR@/@CMAKE_INSTALL_DATADIR@/qml")

# Function to add QML import path
function(conexus_ui_qt_add_qml_import_path)
    list(APPEND QML_IMPORT_PATH "${CONEXUS_UI_QT_QML_IMPORT_PATH}")
    set(QML_IMPORT_PATH ${QML_IMPORT_PATH} PARENT_SCOPE)
endfunction()

# Function to register QML types (if using C++ plugins)
function(conexus_ui_qt_register_types)
    # Call this from your main.cpp before loading QML
    # qmlRegisterTypes<ConexusUIQtPlugin>();
endfunction()